{
  "settingsFallback": true,
  "features": {
    "customTab": true,
    "stencilsTab": true,
    "badge": true,
    "photoControls": true,
    "chatPreview": true,
    "contrastWarning": true,
    "download": true,
    "showInPhoto": true,
    "stencilSearch": true,
    "stencilCategories": true,
    "stencilDropdown": true,
    "stickers": false,
    "badgeMove": true,
    "textMove": true
  },
  "badgeMovement": {
    "restrictInsideFrame": true,
    "restrictOnText": false
  },
  "stickerEmojis": [
    "😀",
    "😎",
    "🎉",
    "❤️",
    "⭐",
    "👍",
    "🔥",
    "🌸"
  ],
  "export": {
    "size": 300,
    "format": "image/png"
  },
  "download": {
    "size": 1024,
    "formats": [
      "image/png",
      "image/jpeg"
    ],
    "fileName": "profile-photo"
  },
  "zoom": {
    "min": 1,
    "max": 3
  },
  "previewSize": 320,
  "minWindowWidth": 1024,
  "minContrast": 3,
  "textMaxLength": 32,
  "badgeLineMaxLength": 14,
  "translateStencilTexts": false
}
